{
  "name": "sed-formulario-actualizacion",
  "version": "1.2.4",
  "private": true,
  "description": "Formulario web 13-IF-016 de actualización de datos (personas naturales, honorarios y servicios personales art. 103 ET) con lectura automática de RUT y RIT en PDF.",
  "scripts": {
    "build": "node tools/build.mjs",
    "catalogos": "py -X utf8 tools/extract_catalogos.py",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:consolidador": "node tools/build.mjs --entrada src/consolidador.html --salida consolidador-13-IF-016.html"
  },
  "devDependencies": {
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  }
}
